# Copie ce fichier en .env.local et remplis les valeurs (.env.local n'est jamais envoyé sur GitHub).

# Supabase > Project Settings > API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique ("anon" ou "publishable"), sans danger dans le navigateur grâce à la RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète ("service_role" ou "secret") : SERVEUR UNIQUEMENT, jamais de NEXT_PUBLIC_ devant
SUPABASE_SERVICE_ROLE_KEY=

# Adresse du site (liens magiques, liens employés)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (étape 11)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_EQUIPE=

# Paiement en ligne : laisser vide pendant le lancement (bêta gratuite).
# Mettre « oui » seulement avec les clés Stripe « live ».
PAIEMENT_OUVERT=

# Alerte e-mail à chaque demande de démo / d'accès (Brevo → SMTP et API → Clés API)
BREVO_API_KEY=
# Adresse qui reçoit les alertes
ALERTE_EMAIL=
# Adresse d'expéditeur validée dans Brevo
ALERTE_EXPEDITEUR=
