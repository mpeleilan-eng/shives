# Copie ce fichier en .env.local et remplis les valeurs (.env.local n'est jamais envoyé sur GitHub).

# Supabase > Project Settings > API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique ("anon" ou "publishable"), sans danger dans le navigateur grâce à la RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète ("service_role" ou "secret") : SERVEUR UNIQUEMENT, jamais de NEXT_PUBLIC_ devant
SUPABASE_SERVICE_ROLE_KEY=

# Adresse du site (liens magiques, liens employés)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (étape 11)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_EQUIPE=
